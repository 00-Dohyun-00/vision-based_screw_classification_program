# 이 파일을 복사해서 .env로 만들고 실제 주소를 채우세요.
#   cp .env.example .env
# .env는 git에 올라가지 않습니다(.gitignore 처리됨) - 내부망 IP 등을 코드에 박아두지 않기 위함.
# Vite 규칙상 VITE_ 로 시작하는 변수만 프론트엔드 코드에서 읽을 수 있습니다.

# <비전서버IP> 자리만 실제 주소로 바꿔주세요 (핫스팟/Wi-Fi IP는 재연결하면 바뀔 수 있음).

# 영상은 경로 패턴이 아예 달라서(/stream.mjpg) 통째로 따로 저장한다.
VITE_VIDEO_URL=http://<비전서버IP>:8765/stream.mjpg

# counts(/counts)와 recipe(/recipe)는 같은 베이스 주소에 경로만 붙여서 쓴다.
# 끝에 슬래시(/) 붙이지 말 것 - 코드에서 /counts, /recipe를 그대로 이어붙임.
VITE_API_BASE_URL=http://<비전서버IP>:8765/api/v1
